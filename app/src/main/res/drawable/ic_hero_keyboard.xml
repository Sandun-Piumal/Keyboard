<?xml version="1.0" encoding="utf-8"?>
<!--
  Hero illustration for the Home screen welcome card: a purple keyboard
  with a white "සිංහල" speech bubble (top-left) and a pink "A" speech
  bubble (top-right), plus sparkle/dot accents. Matches the reference
  artwork. Sinhala glyph rendering isn't reliable in a plain <path>-only
  vector, so the "සිංහල" and "A" bubble labels are drawn as Compose Text
  on top of this drawable in HomeScreen.kt — this vector supplies the
  bubbles' shapes, the keyboard body/keys, and the decorative sparkles.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="280dp"
    android:height="220dp"
    android:viewportWidth="1456"
    android:viewportHeight="1145">

    <!-- soft ground shadow -->
    <path
        android:pathData="M 260,900 a 480,70 0 1,0 960,0 a 480,70 0 1,0 -960,0 Z"
        android:fillColor="#1A2A1240"
        android:fillAlpha="0.18" />

    <!-- keyboard body -->
    <path
        android:pathData="M 340,400
            L 1190,400
            Q 1230,400 1230,440
            L 1230,820
            Q 1230,880 1170,880
            L 400,880
            Q 340,880 340,820
            Z">
        <aapt:attr xmlns:aapt="http://schemas.android.com/aapt" name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="340"
                android:startY="400"
                android:endX="1230"
                android:endY="880"
                android:startColor="#B08CF0"
                android:endColor="#7C4FE0" />
        </aapt:attr>
    </path>

    <!-- row 1 keys -->
    <path android:pathData="M 470,470 h 90 a 20,20 0 0 1 20,20 v 70 a 20,20 0 0 1 -20,20 h -90 a 20,20 0 0 1 -20,-20 v -70 a 20,20 0 0 1 20,-20 Z" android:fillColor="#C6B3F5" android:fillAlpha="0.85"/>
    <path android:pathData="M 590,470 h 90 a 20,20 0 0 1 20,20 v 70 a 20,20 0 0 1 -20,20 h -90 a 20,20 0 0 1 -20,-20 v -70 a 20,20 0 0 1 20,-20 Z" android:fillColor="#C6B3F5" android:fillAlpha="0.85"/>
    <path android:pathData="M 710,470 h 90 a 20,20 0 0 1 20,20 v 70 a 20,20 0 0 1 -20,20 h -90 a 20,20 0 0 1 -20,-20 v -70 a 20,20 0 0 1 20,-20 Z" android:fillColor="#C6B3F5" android:fillAlpha="0.85"/>
    <path android:pathData="M 830,470 h 90 a 20,20 0 0 1 20,20 v 70 a 20,20 0 0 1 -20,20 h -90 a 20,20 0 0 1 -20,-20 v -70 a 20,20 0 0 1 20,-20 Z" android:fillColor="#C6B3F5" android:fillAlpha="0.85"/>
    <path android:pathData="M 950,470 h 90 a 20,20 0 0 1 20,20 v 70 a 20,20 0 0 1 -20,20 h -90 a 20,20 0 0 1 -20,-20 v -70 a 20,20 0 0 1 20,-20 Z" android:fillColor="#C6B3F5" android:fillAlpha="0.85"/>
    <path android:pathData="M 1070,470 h 90 a 20,20 0 0 1 20,20 v 70 a 20,20 0 0 1 -20,20 h -90 a 20,20 0 0 1 -20,-20 v -70 a 20,20 0 0 1 20,-20 Z" android:fillColor="#C6B3F5" android:fillAlpha="0.85"/>

    <!-- row 2 keys -->
    <path android:pathData="M 410,600 h 90 a 20,20 0 0 1 20,20 v 70 a 20,20 0 0 1 -20,20 h -90 a 20,20 0 0 1 -20,-20 v -70 a 20,20 0 0 1 20,-20 Z" android:fillColor="#C6B3F5" android:fillAlpha="0.85"/>
    <path android:pathData="M 530,600 h 90 a 20,20 0 0 1 20,20 v 70 a 20,20 0 0 1 -20,20 h -90 a 20,20 0 0 1 -20,-20 v -70 a 20,20 0 0 1 20,-20 Z" android:fillColor="#C6B3F5" android:fillAlpha="0.85"/>
    <path android:pathData="M 650,600 h 90 a 20,20 0 0 1 20,20 v 70 a 20,20 0 0 1 -20,20 h -90 a 20,20 0 0 1 -20,-20 v -70 a 20,20 0 0 1 20,-20 Z" android:fillColor="#C6B3F5" android:fillAlpha="0.85"/>
