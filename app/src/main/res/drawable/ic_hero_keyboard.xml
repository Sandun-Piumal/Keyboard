    <path android:pathData="M 890,600 h 90 a 20,20 0 0 1 20,20 v 70 a 20,20 0 0 1 -20,20 h -90 a 20,20 0 0 1 -20,-20 v -70 a 20,20 0 0 1 20,-20 Z" android:fillColor="#C6B3F5" android:fillAlpha="0.85"/>
