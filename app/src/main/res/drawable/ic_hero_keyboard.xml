        android:pathData="M 968,100
            C 976,140 984,148 1024,156
            C 984,164 976,172 968,212
            C 960,172 952,164 912,156
            C 952,148 960,140 968,100 Z"
        android:fillColor="#FFFFFF"
        android:fillAlpha="0.9" />

    <!-- small circle dot near sparkle 2 -->
    <path
        android:pathData="M 1050,196 m -14,0 a 14,14 0 1,0 28,0 a 14,14 0 1,0 -28,0"
        android:fillColor="#FFFFFF"
        android:fillAlpha="0.8" />

    <!-- bottom-left decorative dots -->
    <path
        android:pathData="M 168,748 m -22,0 a 22,22 0 1,0 44,0 a 22,22 0 1,0 -44,0"
        android:fillColor="#C6B3F5"
        android:fillAlpha="0.9" />
    <path
        android:pathData="M 210,808 m -12,0 a 12,12 0 1,0 24,0 a 12,12 0 1,0 -24,0"
        android:fillColor="#C6B3F5"
        android:fillAlpha="0.8" />
</vector>
