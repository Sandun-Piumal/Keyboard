<?xml version="1.0" encoding="utf-8"?>
<input-method xmlns:android="http://schemas.android.com/apk/res/android"
    android:settingsActivity="com.spmods.sinkey.MainActivity"
    android:supportsSwitchingToNextInputMethod="true">

    <!-- Shows "Sinhala (Sri Lanka)" under the keyboard name in system settings.
         label "%s" = the system's own display name for the locale. -->
    <subtype
        android:label="@string/subtype_label"
        android:imeSubtypeLocale="si_LK"
        android:imeSubtypeMode="keyboard" />
</input-method>
